{
  "name": "geolibre-raster-elevation-profile",
  "version": "0.1.0",
  "description": "GeoLibre plugin for elevation profiles from loaded COG rasters.",
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.geolibre.config.ts",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/package-plugin.mjs",
    "serve": "node scripts/serve-plugin.mjs"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "maplibre-gl": "^5.6.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  }
}
